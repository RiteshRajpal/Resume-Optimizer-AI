# Copy to .env.local (never commit .env.local). API keys must NOT use NEXT_PUBLIC_
# — only server routes read them; see lib/env.server.ts.

# --- LLM providers (first available in LLM_FALLBACK_ORDER wins; default: groq,openai,gemini,anthropic) ---
# Free tier: https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Comma-separated provider order (lowercase)
# LLM_FALLBACK_ORDER=groq,openai,gemini,anthropic

# Run keyword-only demo without calling any LLM (optional)
# ALLOW_DEMO_OPTIMIZE=true

# Set to true to refuse automatic demo when every LLM fails (strict prod)
# DISABLE_DEMO_FALLBACK=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App Config
NEXT_PUBLIC_APP_NAME="AI Resume Editor"
NEXT_PUBLIC_ENABLE_SUPABASE=true
NEXT_PUBLIC_REQUIRE_AUTH=false
